{
  "manifest_version": 3,
  "name": "Fobifiltr",
  "version": "0.1.0",
  "description": "Rozmaže ve videích na YouTube pavouky, hady a další věci, kterých se bojíš. AI běží přímo v prohlížeči.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://i.ytimg.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://www.youtube-nocookie.com/*"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://www.youtube.com/*", "https://www.youtube-nocookie.com/*"],
      "js": ["categories.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
